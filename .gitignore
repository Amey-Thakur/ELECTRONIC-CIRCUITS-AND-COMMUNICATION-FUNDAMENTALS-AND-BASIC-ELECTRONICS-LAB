# ECCF - Academic Repository
# Specialized .gitignore for electronics and communications archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# Electronics Design & Simulation Tools
# (LTSpice, Multisim, Proteus, KiCad, Eagle)
*.raw
*.fft
*.op.raw
*.net
*.plt
*.log
*.pdsbak
*.backup
*.LBK
*.pdsprj.workspace
*.ewl
*.db
*.bck
*.lck
*.kicad_prl
*.kicad_pcb-bak
*.b#?
*.s#?
*.l#?
*.pro
*.job

# Build Artifacts (Embedded)
*.hex
*.elf
*.o
*.bin
*.map
*.lst
obj/
bin/

# Temporary and Cache files
*.tmp
*.log
.cache/
node_modules/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.aux
*.bbl
*.blg
*.idx
*.ind
*.lof
*.lot
*.out
*.toc
