# ECCF - Academic Repository
# Professional .gitattributes for scholarly archiving

# Set default behavior to automatically normalize line endings
* text=auto

# Ensure text files use LF on checkout
*.md text eol=lf
*.txt text eol=lf
*.cff text eol=lf
LICENSE text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary

# Electronics Design Binaries
*.pdsprj binary
*.DSN    binary
*.DBK    binary
*.sch    binary
*.brd    binary
*.ms*    binary

# Improve diff handling
*.md text diff=markdown
